{
  "name": "stats-front",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "next start",
    "predev": "start http://localhost:3000",
    "dev": "next dev -p 3000",
    "lint": "eslint .",
    "lint:styles": "stylelint \"src/**/*.{ts,tsx,css}\"",
    "prebuild": "npm run lint && npm run lint:styles",
    "build": "next build",
    "postbuild": "next-sitemap",
    "prepare": "husky",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\""
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@lucide/lab": "^0.1.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-select": "^2.2.6",
    "axios": "^1.13.6",
    "lucide-react": "^0.577.0",
    "next": "16.1.7",
    "next-sitemap": "^4.2.3",
    "nookies": "^2.5.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.2",
    "react-spinners": "^0.17.0",
    "styled-components": "^6.3.11",
    "swiper": "^12.1.2",
    "usehooks-ts": "^3.1.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/styled-components": "^5.1.36",
    "eslint": "^9",
    "eslint-config-next": "16.1.7",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "postcss-styled-syntax": "^0.7.3",
    "prettier": "^3.9.9",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  }
}
